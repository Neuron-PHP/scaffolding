<?php

namespace {{repoNamespace}};

use {{modelNamespace}}\{{model}};
use Neuron\Data\Settings\SettingManager;
use PDO;
use Exception;

/**
 * Database-backed {{model}} repository using the Neuron ORM.
 *
 * Generated by the Neuron scaffold command. Works with SQLite, MySQL and
 * PostgreSQL.
 *
 * @package {{repoNamespace}}
 */
class {{repoClass}} implements {{repoInterface}}
{
	private PDO $_pdo;

	/**
	 * @param SettingManager $settings Settings manager with a `database` section
	 * @throws Exception if database configuration is missing or unsupported
	 */
	public function __construct( SettingManager $settings )
	{
		$this->_pdo = $this->createConnection( $settings );
		{{model}}::setPdo( $this->_pdo );
	}

	/**
	 * @inheritDoc
	 */
	public function findById( int $id ): ?{{model}}
	{
		return {{model}}::query()->where( '{{primaryKey}}', $id )->first();
	}

	/**
	 * @inheritDoc
	 */
	public function all(): array
	{
		return {{model}}::query()->orderBy( '{{primaryKey}}', 'DESC' )->get();
	}

	/**
	 * @inheritDoc
	 */
	public function create( {{model}} ${{variable}} ): {{model}}
	{
		${{variable}}->save();

		return ${{variable}};
	}

	/**
	 * @inheritDoc
	 */
	public function update( {{model}} ${{variable}} ): bool
	{
		return ${{variable}}->save();
	}

	/**
	 * @inheritDoc
	 */
	public function delete( int $id ): bool
	{
		return {{model}}::query()->where( '{{primaryKey}}', $id )->delete() > 0;
	}

	/**
	 * @inheritDoc
	 */
	public function count(): int
	{
		return {{model}}::query()->count();
	}

	/**
	 * Build a PDO connection from the application's database settings.
	 *
	 * @param SettingManager $settings
	 * @return PDO
	 * @throws Exception
	 */
	private function createConnection( SettingManager $settings ): PDO
	{
		$config = $settings->getSection( 'database' );

		if( !$config )
		{
			throw new Exception( 'Database configuration not found in settings' );
		}

		$adapter = $config['adapter'] ?? 'sqlite';

		if( empty( $config['name'] ) )
		{
			throw new Exception( 'Database "name" configuration is required.' );
		}

		$dsn = match( $adapter )
		{
			'sqlite' => "sqlite:{$config['name']}",
			'mysql'  => sprintf(
				'mysql:host=%s;port=%s;dbname=%s;charset=%s',
				$config['host'] ?? 'localhost',
				$config['port'] ?? 3306,
				$config['name'],
				$config['charset'] ?? 'utf8mb4'
			),
			'pgsql'  => sprintf(
				'pgsql:host=%s;port=%s;dbname=%s',
				$config['host'] ?? 'localhost',
				$config['port'] ?? 5432,
				$config['name']
			),
			default  => throw new Exception( "Unsupported database adapter: $adapter" )
		};

		return new PDO(
			$dsn,
			$config['user'] ?? $config['username'] ?? null,
			$config['pass'] ?? $config['password'] ?? null,
			[
				PDO::ATTR_ERRMODE            => PDO::ERRMODE_EXCEPTION,
				PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC
			]
		);
	}
}
