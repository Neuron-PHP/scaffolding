<?php
/**
 * {{models}} listing.
 *
 * Generated by the Neuron scaffold command.
 *
 * @var {{model}}[] ${{variables}}
 */
?>
<h1><?= htmlspecialchars( $Title ?? '{{models}}' ) ?></h1>

<p><a href="{{routePrefix}}/create">Create {{model}}</a></p>

<table>
	<thead>
		<tr>
{{indexHeaders}}
			<th>Actions</th>
		</tr>
	</thead>
	<tbody>
<?php foreach( ${{variables}} as ${{variable}} ): ?>
		<tr>
{{indexCells}}
			<td>
				<a href="{{routePrefix}}/<?= ${{variable}}->{{primaryKeyGetter}}() ?>/edit">Edit</a>
				<form method="post" action="{{routePrefix}}/<?= ${{variable}}->{{primaryKeyGetter}}() ?>" style="display:inline" onsubmit="return confirm('Delete this {{model}}?');">
					<?= csrf_field() ?>
					<input type="hidden" name="_method" value="DELETE">
					<button type="submit">Delete</button>
				</form>
			</td>
		</tr>
<?php endforeach; ?>
	</tbody>
</table>
