<?php

namespace {{namespace}};

use Neuron\Mvc\Controllers\Base;
use Neuron\Mvc\Requests\Request;
use Neuron\Mvc\Responses\HttpResponseStatus;
use Neuron\Mvc\Views\Html;
use Neuron\Core\Registry\RegistryKeys;
use Neuron\Patterns\Registry;
use Neuron\Dto\Factory as DtoFactory;
use Neuron\Dto\Dto;
use {{modelNamespace}}\{{model}};
use {{repoNamespace}}\{{repoInterface}};
use {{repoNamespace}}\{{repoClass}};

/**
 * {{class}} - RESTful controller for {{model}} resources.
 *
 * Generated by the Neuron scaffold command. CRUD is backed by the
 * Neuron ORM via {{repoInterface}}; form input is validated through a
 * generated DTO definition.
 *
 * @package {{namespace}}
 */
class {{class}} extends Base
{
	private ?{{repoInterface}} $_repository = null;

	/**
	 * @param \Neuron\Mvc\IMvcApplication $app
	 * @param {{repoInterface}}|null $repository Optional repository (injected by the DI container when available)
	 */
	public function __construct( \Neuron\Mvc\IMvcApplication $app, ?{{repoInterface}} $repository = null )
	{
		parent::__construct( $app );
		$this->_repository = $repository;
	}

	/**
	 * Display a listing of {{models}}.
	 */
	#[\Neuron\Routing\Attributes\Get( '{{routePrefix}}', name: '{{routeName}}_index' )]
	public function index( Request $request ): string
	{
		return $this->renderView( 'index', HttpResponseStatus::OK, [
			'Title'         => '{{models}}',
			'Description'   => 'Manage {{models}}',
			'{{variables}}' => $this->repository()->all()
		] );
	}

	/**
	 * Show the form for creating a new {{model}}.
	 */
	#[\Neuron\Routing\Attributes\Get( '{{routePrefix}}/create', name: '{{routeName}}_create' )]
	public function create( Request $request ): string
	{
		return $this->renderView( 'create', HttpResponseStatus::OK, [
			'Title'       => 'Create {{model}}',
			'Description' => 'Create a new {{model}}',
			'errors'      => [],
			'old'         => []
		] );
	}

	/**
	 * Store a newly created {{model}}.
	 */
	#[\Neuron\Routing\Attributes\Post( '{{routePrefix}}', name: '{{routeName}}_store', filters: ['csrf'] )]
	public function store( Request $request ): string
	{
		$dto = $this->dto();
		$this->mapRequestToDto( $dto, $request );

		if( !$dto->validate() )
		{
			return $this->renderView( 'create', HttpResponseStatus::BAD_REQUEST, [
				'Title'       => 'Create {{model}}',
				'Description' => 'Create a new {{model}}',
				'errors'      => $dto->getErrors(),
				'old'         => $this->dtoToArray( $dto )
			] );
		}

		$model = {{model}}::fromArray( $this->dtoToArray( $dto ) );
		$this->repository()->create( $model );

		header( 'Location: {{routePrefix}}' );
		exit;
	}

	/**
	 * Show the form for editing the specified {{model}}.
	 */
	#[\Neuron\Routing\Attributes\Get( '{{routePrefix}}/:id/edit', name: '{{routeName}}_edit' )]
	public function edit( Request $request ): string
	{
		$id = (int)$request->getRouteParameter( 'id' );
		${{variable}} = $this->repository()->findById( $id );

		if( !${{variable}} )
		{
			return $this->renderView( 'index', HttpResponseStatus::NOT_FOUND, [
				'Title'         => '{{models}}',
				'{{variables}}' => $this->repository()->all()
			] );
		}

		return $this->renderView( 'edit', HttpResponseStatus::OK, [
			'Title'        => 'Edit {{model}}',
			'Description'  => 'Edit {{model}}',
			'{{variable}}' => ${{variable}},
			'errors'       => [],
			'old'          => []
		] );
	}

	/**
	 * Update the specified {{model}}.
	 */
	#[\Neuron\Routing\Attributes\Put( '{{routePrefix}}/:id', name: '{{routeName}}_update', filters: ['csrf'] )]
	public function update( Request $request ): string
	{
		$id = (int)$request->getRouteParameter( 'id' );
		$dto = $this->dto();
		$this->mapRequestToDto( $dto, $request );

		if( !$dto->validate() )
		{
			return $this->renderView( 'edit', HttpResponseStatus::BAD_REQUEST, [
				'Title'        => 'Edit {{model}}',
				'Description'  => 'Edit {{model}}',
				'{{variable}}' => $this->repository()->findById( $id ),
				'errors'       => $dto->getErrors(),
				'old'          => $this->dtoToArray( $dto )
			] );
		}

		$data = $this->dtoToArray( $dto );
		$data['{{primaryKey}}'] = $id;
		$model = {{model}}::fromArray( $data );
		$this->repository()->update( $model );

		header( 'Location: {{routePrefix}}' );
		exit;
	}

	/**
	 * Remove the specified {{model}}.
	 */
	#[\Neuron\Routing\Attributes\Delete( '{{routePrefix}}/:id', name: '{{routeName}}_destroy', filters: ['csrf'] )]
	public function destroy( Request $request ): string
	{
		$id = (int)$request->getRouteParameter( 'id' );
		$this->repository()->delete( $id );

		header( 'Location: {{routePrefix}}' );
		exit;
	}

	/**
	 * Render an HTML view from this resource's view directory.
	 *
	 * @param string $page
	 * @param HttpResponseStatus $status
	 * @param array<string, mixed> $data
	 * @return string
	 */
	private function renderView( string $page, HttpResponseStatus $status, array $data ): string
	{
		@http_response_code( $status->value );

		$view = new Html();
		$view->setController( '{{viewPath}}' )
			 ->setLayout( 'default' )
			 ->setPage( $page );

		return $view->render( $data );
	}

	/**
	 * Lazily resolve the repository, building it from settings when the DI
	 * container did not inject one.
	 */
	private function repository(): {{repoInterface}}
	{
		if( $this->_repository === null )
		{
			$settings = Registry::getInstance()->get( RegistryKeys::SETTINGS );
			$this->_repository = new {{repoClass}}( $settings );
		}

		return $this->_repository;
	}

	/**
	 * Create the request DTO from the generated YAML definition.
	 */
	private function dto(): Dto
	{
		$basePath = Registry::getInstance()->get( RegistryKeys::BASE_PATH );

		return ( new DtoFactory( $basePath . '/resources/dtos/{{tableName}}.yaml' ) )->create();
	}

	/**
	 * Map sanitized POST values onto the DTO, casting form strings to the
	 * declared scalar types.
	 */
	private function mapRequestToDto( Dto $dto, Request $request ): void
	{
		foreach( $dto->getProperties() as $name => $property )
		{
			$value = $request->post( $name, null );

			if( $value === null )
			{
				continue;
			}

			$type = $property->getType();

			if( $type === 'boolean' )
			{
				$dto->$name = ( $value === 'on' || $value === '1' || $value === 1 || $value === true );
				continue;
			}

			if( $type === 'integer' || $type === 'float' )
			{
				if( $value === '' )
				{
					continue;
				}

				if( is_numeric( $value ) )
				{
					$dto->$name = ( $type === 'integer' ) ? (int)$value : (float)$value;
					continue;
				}
			}

			$dto->$name = $value;
		}
	}

	/**
	 * Flatten the DTO scalar properties to an array for model hydration.
	 *
	 * @return array<string, mixed>
	 */
	private function dtoToArray( Dto $dto ): array
	{
		$data = [];

		foreach( $dto->getProperties() as $name => $property )
		{
			$data[ $name ] = $dto->$name;
		}

		return $data;
	}
}
