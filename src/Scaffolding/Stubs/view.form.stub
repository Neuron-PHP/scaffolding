<?php
/**
 * Shared {{model}} form fields.
 *
 * Generated by the Neuron scaffold command.
 *
 * @var array  $values     Current field values keyed by column name
 * @var array  $errors     Validation errors keyed by field name
 * @var string $formAction Form action URL
 * @var string $formMethod HTTP verb (POST, PUT, ...)
 */
?>
<form method="post" action="<?= htmlspecialchars( $formAction ) ?>">
	<?= csrf_field() ?>
<?php if( ( $formMethod ?? 'POST' ) !== 'POST' ): ?>
	<input type="hidden" name="_method" value="<?= htmlspecialchars( $formMethod ) ?>">
<?php endif; ?>
{{formFields}}
	<button type="submit">Save</button>
</form>
