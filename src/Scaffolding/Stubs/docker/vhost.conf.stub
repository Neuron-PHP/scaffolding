# Generated by `neuron docker:install`.
<VirtualHost *:80>
    ServerName localhost
    DocumentRoot "/var/www/{{docroot}}"

    <Directory "/var/www/{{docroot}}">
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>

    LogLevel warn
    ErrorLog /proc/self/fd/2
    CustomLog /proc/self/fd/1 combined
</VirtualHost>
