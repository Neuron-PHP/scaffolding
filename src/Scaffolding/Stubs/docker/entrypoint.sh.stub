#!/bin/sh
# Generated by `neuron docker:install`.
# Runs before every role's command; keep it quick and idempotent.
set -e

cd /var/www

# Best effort: on a bind mount the host owns these and may already have them.
mkdir -p storage/logs storage/cache 2>/dev/null || true

# Platforms such as Railway hand the web role a PORT. Rewrite Apache's
# listener only when we are the web role and can write the config.
case "$1" in
    apache2*)
        if [ -n "${PORT:-}" ] && [ "${PORT}" != "80" ] && [ -w /etc/apache2/ports.conf ]; then
            sed -i "s/^Listen 80$/Listen ${PORT}/" /etc/apache2/ports.conf
            sed -i "s/<VirtualHost \*:80>/<VirtualHost *:${PORT}>/" /etc/apache2/sites-available/000-default.conf
        fi
        ;;
esac

# Opt-in migration step for platforms without a pre-deploy hook.
if [ "${RUN_MIGRATIONS:-0}" = "1" ]; then
    php vendor/bin/neuron db:migrate
fi

exec "$@"
