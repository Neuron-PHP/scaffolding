
  # The PHP services reach this through DATABASE_URL (see x-app above).
  db:
    image: postgres:17
    environment:
      POSTGRES_DB: ${DB_NAME:-neuron}
      POSTGRES_USER: ${DB_USER:-neuron}
      POSTGRES_PASSWORD: ${DB_PASS:-neuron}
    ports:
      - "${DB_PORT:-5432}:5432"
    volumes:
      - db-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${DB_USER:-neuron} -d ${DB_NAME:-neuron}"]
      interval: 5s
      timeout: 3s
      retries: 30
