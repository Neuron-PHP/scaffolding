# syntax=docker/dockerfile:1
# Generated by `neuron docker:install`.
#
# One image serves every role; only the command differs:
#   web        apache2-foreground                       (default CMD)
#   scheduler  php vendor/bin/neuron jobs:schedule
#   worker     php vendor/bin/neuron jobs:work --queue=...
#
# Targets:
#   dev   xdebug installed (off by default), source bind-mounted by docker compose
#   prod  vendor/ baked in, opcache without timestamp checks, errors to the log
#
# The entrypoint `exec`s the command so PHP is PID 1 and receives signals.
# The base image's STOPSIGNAL is SIGWINCH (Apache graceful stop). jobs:work
# and jobs:schedule (neuron-php/jobs >= 0.2.18) stop cleanly on it when run
# headless; on older versions give CLI containers `--stop-signal SIGTERM`.

ARG PHP_VERSION={{php_version}}

# ---------------------------------------------------------------------------
FROM php:${PHP_VERSION}-apache AS base

ENV APP_ROOT=/var/www \
    DOCUMENT_ROOT=/var/www/{{docroot}} \
    COMPOSER_ALLOW_SUPERUSER=1

WORKDIR /var/www

# pcntl is required for job timeouts (SIGALRM) and graceful worker shutdown.
COPY --from=mlocati/php-extension-installer /usr/bin/install-php-extensions /usr/local/bin/
RUN apt-get update \
    && apt-get install -y --no-install-recommends git unzip zip \
    && install-php-extensions calendar mbstring pcntl sockets zip opcache {{php_extensions}} \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

COPY .docker/php.ini /usr/local/etc/php/conf.d/zz-neuron.ini
COPY .docker/vhost.conf /etc/apache2/sites-available/000-default.conf
COPY .docker/entrypoint.sh /usr/local/bin/neuron-entrypoint

RUN chmod +x /usr/local/bin/neuron-entrypoint \
    && a2enmod rewrite headers \
    && echo "ServerName localhost" >> /etc/apache2/apache2.conf

ENTRYPOINT ["neuron-entrypoint"]
CMD ["apache2-foreground"]

# ---------------------------------------------------------------------------
FROM base AS dev

RUN install-php-extensions xdebug \
    && { \
        echo 'xdebug.mode=off'; \
        echo 'xdebug.client_host=host.docker.internal'; \
        echo 'xdebug.client_port=9003'; \
        echo 'xdebug.start_with_request=trigger'; \
    } > /usr/local/etc/php/conf.d/zz-xdebug.ini

# Set XDEBUG_MODE=debug in the environment to turn debugging on.
ENV XDEBUG_MODE=off \
    APP_ENV=local

# Source (including vendor/) is bind-mounted from the host by docker-compose.

# ---------------------------------------------------------------------------
FROM base AS prod

ENV APP_ENV=production

RUN { \
        echo 'opcache.validate_timestamps=0'; \
        echo 'display_errors=Off'; \
        echo 'log_errors=On'; \
    } > /usr/local/etc/php/conf.d/zz-prod.ini

# Dependencies first so the layer is reused while only application code changes.
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --no-progress --no-scripts --no-autoloader

COPY . .

RUN composer dump-autoload --no-dev --optimize \
    && mkdir -p storage/logs storage/cache \
    && chown -R www-data:www-data storage

EXPOSE 80
