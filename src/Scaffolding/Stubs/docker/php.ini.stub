; Generated by `neuron docker:install`. Applies to Apache and CLI.

; Must stay above `jobs:work --memory` so the worker can recycle itself
; before PHP hits the hard limit.
memory_limit = 256M

expose_php = Off
date.timezone = UTC
upload_max_filesize = 20M
post_max_size = 24M

opcache.enable = 1
opcache.enable_cli = 0
opcache.memory_consumption = 128
opcache.max_accelerated_files = 20000
