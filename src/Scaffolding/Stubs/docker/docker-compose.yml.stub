# Generated by `neuron docker:install`.
#
# Development stack. Every PHP service runs the same image with the source
# bind-mounted, so `composer install` on the host is all they need.
#
#   docker compose up -d                 start {{services_hint}}
#   docker compose up -d --scale worker=3
#   docker compose exec app php vendor/bin/neuron jobs:stats
#   docker compose restart worker        pick up new code (or `jobs:restart`)
#
# ./storage (SQLite file, logs, jobs restart file) is shared by every role
# through the bind mount.

x-app: &app
  build:
    context: .
    target: dev
  image: {{image}}
  init: true
  working_dir: /var/www
  volumes:
    - .:/var/www
  env_file:
    - path: .env
      required: false
  environment:
    APP_ENV: ${APP_ENV:-local}
    XDEBUG_MODE: ${XDEBUG_MODE:-off}
{{database_url}}{{depends_on}}
services:
  app:
    <<: *app
    ports:
      - "${APP_PORT:-8080}:80"
{{job_services}}{{extra_services}}{{volumes}}